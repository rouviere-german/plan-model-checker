# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=plan-model-checker
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys, each optionally followed by
# ":scope+scope" (scopes: check, monitor, repair, override, approve; default check+monitor).
# Generate a key with: uv run plan-model-checker generate-api-key --scopes check+monitor
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Agentic kit. Tests, demo and bench run offline and never need a key.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_PLANNER_MODEL=claude-sonnet-5
APP_LLM_REPAIR_MODEL=claude-opus-5
# scripted (offline, inserts the step a counterexample names) or anthropic (needs the key).
APP_REPAIRER=scripted
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0

# Plan model checker. Without APP_REGISTRY_PATH the built-in registry is signed with an
# ephemeral key at start-up (development only; /readyz fails in prod).
APP_REGISTRY_PATH=
# Comma-separated hex Ed25519 public keys trusted to sign the registry bundle.
APP_REGISTRY_PUBLIC_KEYS=
# Optional pin: the registry's canonical SHA-256 must equal this value.
APP_REGISTRY_SHA256=
# Optional spec document; defaults to the built-in resource-protocol specs.
APP_SPECS_PATH=
APP_REPAIR_MAX_ATTEMPTS=3
APP_CHECK_MAX_STATES=250000
APP_PLAN_MAX_NODES=200
APP_PLAN_MAX_DEPTH=8
APP_PLAN_MAX_LOOP_BOUND=8

APP_DATA_DIR=var
